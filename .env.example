# База данных
POSTGRES_DB=tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# Учётка репетитора: создаётся при первом старте backend (пароль не короче 8 символов)
TUTOR_LOGIN=teacher
TUTOR_PASSWORD=change-me-too
TUTOR_NAME=Репетитор

# Приложение
APP_ORIGIN=http://localhost
APP_TIMEZONE=Europe/Moscow
SESSION_DAYS=30
# На сколько недель вперёд worker порождает занятия из серий
SCHEDULE_HORIZON_WEEKS=12

# Порт, на котором nginx фронтенда смотрит наружу (по умолчанию 80)
FRONTEND_PORT=80
